# ============================================================
# Backend/.env — UBND xã Phước Năng · Tiếp nhận phản ánh, góp ý qua Zalo OA
# Sao chép thành Backend/.env rồi điền giá trị thật. KHÔNG commit file .env.
# ============================================================

# ===== Máy chủ =====
PORT=3015
NODE_ENV=production
# Tên miền công khai của Backend trên VPS (không có / cuối). BẮT BUỘC: dùng để tạo link ảnh
# gửi lên Cổng góp ý 1022 + nhóm Zalo, và link form phản ánh trong tin nhắn OA.
PUBLIC_URL=https://phuocnang.dxvtech.vn
# Thêm tên miền frontend khác (nếu deploy web admin/ReportApp ở tên miền riêng), cách nhau dấu phẩy
CORS_ORIGINS=

# ===== Đơn vị =====
ORG_NAME=UBND xã Phước Năng
ORG_AREA=Xã Phước Năng, Đà Nẵng

# ===== Lưu trữ trên VPS (thay Redis + Cloudinary) =====
# Nên đặt NGOÀI thư mục code để deploy (git reset --hard) không ảnh hưởng dữ liệu.
# DATA_DIR: token Zalo OA, cache profile, danh sách nhóm/follower
# UPLOAD_DIR: ảnh phản ánh + đính kèm xử lý, phục vụ công khai tại PUBLIC_URL/uploads/...
DATA_DIR=/var/lib/phuocnang/data
UPLOAD_DIR=/var/lib/phuocnang/uploads

# ===== MongoDB =====
MONGO_URI=mongodb://127.0.0.1:27017/phuocnang_phananh

# ===== Bảo mật =====
# Chuỗi ngẫu nhiên dài, VD tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Mật khẩu tài khoản admin tạo lần đầu (username: admin). Bỏ trống → sinh ngẫu nhiên và in ra log.
ADMIN_PASSWORD=
# Mã bảo vệ trang /admin/set-tokens (dán token Zalo thủ công). Bỏ trống → trang bị tắt.
TOKEN_SETUP_KEY=

# ===== Zalo OA =====
ZALO_APP_ID=
ZALO_APP_SECRET=
# Chỉ dùng làm giá trị khởi tạo lần đầu — sau đó token tự refresh và lưu ở DATA_DIR/zalo-token.json.
# Cách khác: mở link cấp quyền OA với Callback URL = PUBLIC_URL/ để server tự nhận token.
ZALO_OA_TOKEN=
ZALO_REFRESH_TOKEN=
# Nhóm Zalo mặc định nhận thông báo khi danh mục chưa gán nhóm riêng
ZALO_GROUP_ID=
# Asset ID (gói GMF) — chỉ cần khi tạo nhóm Zalo mới từ trang Cài đặt nhóm
ZALO_ASSET_ID=
# Mã xác thực tên miền trên developers.zalo.me (phần sau "zalo_verifier" trong tên file .html)
ZALO_SITE_VERIFICATION=

# ===== Cổng góp ý 1022 (gopy.danang.gov.vn) — để trống BASE_URL/USERNAME/PASSWORD để tắt =====
CGY1022_BASE_URL=https://gopy.danang.gov.vn
CGY1022_USERNAME=
CGY1022_PASSWORD=
CGY1022_GOPY_PATH=/api/gopy
CGY1022_USER_ID=0
CGY1022_DEFAULT_EMAIL=
# Giá trị API nguồn góp ý do 1022 cấp cho Phước Năng (hỏi bên 1022; "Zalo" là giá trị chung)
CGY1022_NGUON=Zalo
# Map tên danh mục → linhVucId 1022 (JSON 1 dòng). Tên phải khớp CHÍNH XÁC tên nhóm Zalo
# (danh mục được đồng bộ từ tên nhóm Zalo — đổi tên nhóm trên Zalo thì phải sửa map này).
# Đã kiểm chứng trên production (Document/TichHop_1022_TomTat.md): 1 = Hạ tầng đô thị,
# 22 = Lĩnh vực khác, 5000 = Công vụ - Công chức, 21 = An ninh trật tự.
# Khi map khác rỗng, form ReportApp CHỈ hiện các danh mục có trong map.
CGY1022_LINHVUC_MAP={"Môi trường,XD, Hạ tầng (PN)":1,"Văn hoá, Giáo dục, Y tế(PN)":22,"DVC, Thủ tục hành chính (PN)":5000,"An ninh trật tự, PCCC (PN)":21}
# linhVucId dùng cho danh mục chưa map (để trống = phản ánh chưa map sẽ không đẩy được lên 1022)
CGY1022_LINHVUC_DEFAULT=22
CGY1022_SHOW_PHONE_LINHVUC=1,21

# ===== Tuỳ chọn =====
# Khung tìm địa chỉ Nominatim "min_lng,max_lat,max_lng,min_lat" — thu hẹp quanh xã cho kết quả chính xác hơn
GEOCODE_VIEWBOX=
