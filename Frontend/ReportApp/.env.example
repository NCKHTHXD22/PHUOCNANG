# Để trống nếu ReportApp được Express serve cùng origin tại /report (mặc định — xem Backend/server.js).
# Chỉ điền URL tuyệt đối nếu deploy ReportApp riêng ở tên miền khác Backend.
VITE_API_URL=

# App ID Zalo của Phước Năng — PHẢI đã bật quyền "Đăng nhập Zalo" trên Zalo Developers Console,
# và khai báo Callback URL = <PUBLIC_URL>/report/ (trùng ZALO_APP_ID trong Backend/.env).
VITE_ZALO_APP_ID=

# Tên đơn vị hiển thị trên form
VITE_ORG_NAME=UBND xã Phước Năng
