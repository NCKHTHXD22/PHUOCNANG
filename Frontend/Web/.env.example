# Để trống khi web admin được Express serve cùng tên miền tại /app (mặc định).
# Chỉ điền khi deploy web admin ở tên miền khác Backend (nhớ thêm tên miền đó vào CORS_ORIGINS của Backend).
VITE_API_URL=

# Tâm bản đồ trang đăng nhập "lat,lng" + mức zoom. Chỉnh theo vị trí trụ sở / trung tâm xã.
VITE_MAP_CENTER=15.4300,107.8700
VITE_MAP_ZOOM=13
